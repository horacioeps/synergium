{
  "version": 2,
  "title": "Brief de alineación de match (fase 2)",
  "locale": "es",
  "description": "Has sido emparejado/a a través del directorio de la comunidad Synergium. Antes de la introducción conjunta, cada persona rellena este brief corto (unos 8 minutos) para dejar más claras las expectativas sobre objetivos, roles, autoría y datos desde el principio.\n\nTus respuestas las ve Synergium hasta que ambas partes completen el formulario. Entonces enviamos a tu match un resumen de una página con los puntos no confidenciales antes de la introducción.\n\nNo es un contrato y Synergium no es parte de la colaboración. Es un paso de facilitación para reducir malentendidos después (papers, datos, PI).\n\nDudas: info@synergium.net.",
  "success_message": "Gracias. Tu brief de alineación está guardado. Cuando tu match también lo haya completado, seguiremos con la introducción y un resumen breve.",
  "ui": {
    "submit": "Enviar",
    "sending": "Enviando…",
    "other": "Otro",
    "other_placeholder": "Otra cosa…",
    "url_placeholder": "Una URL por línea",
    "thank_you": "Gracias",
    "foot": "Tus respuestas se almacenan de forma segura. Para solicitar el borrado, escribe a info@synergium.net.",
    "complete": "Completa: ",
    "submit_error": "No se pudo enviar. Inténtalo de nuevo.",
    "loading": "Cargando…",
    "missing_link": "Abre el enlace del formulario que te dieron.",
    "missing_form": "Este formulario está cerrado o el enlace no es válido.",
    "load_error": "No se pudo cargar el formulario."
  },
  "fields": [
    {
      "id": "full_name",
      "type": "text",
      "label": "Nombre completo",
      "required": true
    },
    {
      "id": "email",
      "type": "email",
      "label": "Correo (el que usarás para este match)",
      "required": true
    },
    {
      "id": "match_reference",
      "type": "text",
      "label": "Referencia del match (si Synergium te la dio, p. ej. match-2026-042)",
      "required": false
    },
    {
      "id": "goal_horizon",
      "type": "single_select",
      "label": "En las próximas 4–12 semanas, ¿qué quieres tener avanzado?",
      "required": true,
      "allow_other": true,
      "options": [
        { "value": "8_weeks", "label": "Un hito claro en ~8 semanas" },
        { "value": "longer", "label": "Horizonte más largo; es exploratorio" },
        { "value": "unsure", "label": "Aún no lo tengo claro" },
        { "value": "12_weeks", "label": "Avance en ~12 semanas" },
        { "value": "4_weeks", "label": "Algo concreto en ~4 semanas" }
      ]
    },
    {
      "id": "goal_detail",
      "type": "textarea",
      "label": "En una o dos frases: ¿cómo sería el \"éxito\" en ese horizonte?",
      "required": true
    },
    {
      "id": "deliverable_type",
      "type": "single_select",
      "label": "Entregable principal que tienes en mente",
      "required": true,
      "allow_other": true,
      "options": [
        { "value": "exploratory", "label": "Solo llamada exploratoria por ahora" },
        { "value": "grant", "label": "Grant o solicitud de financiación" },
        { "value": "joint_paper", "label": "Artículo empírico conjunto" },
        { "value": "dataset", "label": "Dataset compartido o pieza metodológica" },
        { "value": "protocol", "label": "Protocolo / pre-registro" }
      ]
    },
    {
      "id": "starting_point",
      "type": "single_select",
      "label": "¿Desde dónde partís?",
      "required": true,
      "allow_other": true,
      "options": [
        { "value": "data_exists", "label": "Ya hay datos (propios o accesibles)" },
        { "value": "idea", "label": "Solo idea / tema" },
        { "value": "manuscript_draft", "label": "Borrador de manuscrito en curso" },
        { "value": "protocol_draft", "label": "Borrador de protocolo o diseño" }
      ]
    },
    {
      "id": "my_primary_role",
      "type": "multi_select",
      "label": "Mi aporte principal en esta colaboración sería",
      "required": true,
      "allow_other": true,
      "options": [
        { "value": "clinical", "label": "Mirada clínica o aplicada" },
        { "value": "coordination", "label": "Coordinación / gestión del proyecto" },
        { "value": "analysis", "label": "Análisis de datos / estadística" },
        { "value": "ethics", "label": "Ética / CEI / consentimiento" },
        { "value": "design", "label": "Diseño del estudio" },
        { "value": "writing", "label": "Redacción" }
      ]
    },
    {
      "id": "hours_per_week",
      "type": "single_select",
      "label": "Horas realistas por semana en los próximos 2 meses",
      "required": true,
      "allow_other": true,
      "options": [
        { "value": "0_2", "label": "0–2 horas" },
        { "value": "10_plus", "label": "Más de 10 horas" },
        { "value": "2_5", "label": "2–5 horas" },
        { "value": "5_10", "label": "5–10 horas" }
      ]
    },
    {
      "id": "match_language",
      "type": "single_select",
      "label": "Idioma preferido para trabajar con tu match",
      "required": true,
      "allow_other": true,
      "options": [
        { "value": "ar", "label": "العربية" },
        { "value": "de", "label": "Deutsch" },
        { "value": "en", "label": "English" },
        { "value": "es", "label": "Español" },
        { "value": "it", "label": "Italiano" },
        { "value": "ja", "label": "日本語" },
        { "value": "pt", "label": "Português" },
        { "value": "zh-CN", "label": "简体中文" }
      ]
    },
    {
      "id": "contact_channel_peer",
      "type": "single_select",
      "label": "Canal preferido con tu match (no con Synergium)",
      "required": true,
      "allow_other": true,
      "options": [
        { "value": "email", "label": "Email" },
        { "value": "mixed", "label": "Mezcla de email y llamadas" },
        { "value": "video", "label": "Videollamada primero, luego async" },
        { "value": "whatsapp", "label": "WhatsApp" }
      ]
    },
    {
      "id": "contact_frequency",
      "type": "single_select",
      "label": "Frecuencia de contacto esperada al inicio",
      "required": true,
      "allow_other": true,
      "options": [
        { "value": "biweekly", "label": "Aproximadamente quincenal" },
        { "value": "weekly", "label": "Aproximadamente semanal" },
        { "value": "once_async", "label": "Una reunión y luego sobre todo async" },
        { "value": "as_needed", "label": "Solo si algo se bloquea" }
      ]
    },
    {
      "id": "authorship_order_default",
      "type": "single_select",
      "label": "Regla por defecto que asumes para el orden de autores (si no se habla)",
      "required": true,
      "allow_other": true,
      "options": [
        { "value": "alternating", "label": "Alternando entre papers" },
        { "value": "contribution", "label": "Por contribución" },
        { "value": "discuss_first", "label": "Hay que hablarlo en la primera reunión" },
        { "value": "senior_first", "label": "Senior primero o último según norma del campo" }
      ]
    },
    {
      "id": "corresponding_author",
      "type": "single_select",
      "label": "Autor de correspondencia (preliminar)",
      "required": true,
      "allow_other": true,
      "options": [
        { "value": "them", "label": "Espero que mi match sea autor de correspondencia" },
        { "value": "me", "label": "Yo sería autor de correspondencia" },
        { "value": "shared", "label": "Compartido / co-correspondencia" },
        { "value": "discuss", "label": "A acordar en la primera reunión" }
      ]
    },
    {
      "id": "authorship_non_negotiable",
      "type": "textarea",
      "label": "Una condición de autoría no negociable para ti (o escribe \"ninguna\")",
      "required": true
    },
    {
      "id": "personal_health_data",
      "type": "single_select",
      "label": "¿Esta colaboración implicará datos personales o clínicos?",
      "required": true,
      "allow_other": true,
      "options": [
        { "value": "no", "label": "No" },
        { "value": "unsure", "label": "Aún no lo sé" },
        { "value": "yes", "label": "Sí" }
      ]
    },
    {
      "id": "ethics_lead",
      "type": "single_select",
      "label": "¿Quién debería liderar ética / consentimiento (si aplica)?",
      "required": true,
      "allow_other": true,
      "options": [
        { "value": "institution", "label": "Institución / envío conjunto" },
        { "value": "me", "label": "Yo" },
        { "value": "them", "label": "Mi match" },
        { "value": "na", "label": "No aplica / aún no lo sé" }
      ]
    },
    {
      "id": "data_reuse",
      "type": "single_select",
      "label": "Reutilización de datos después de este proyecto",
      "required": true,
      "allow_other": true,
      "options": [
        { "value": "open", "label": "Abierto / compartido por defecto" },
        { "value": "this_only", "label": "Solo para este estudio salvo acuerdo" },
        { "value": "reuse_agreement", "label": "Reutilizable con acuerdo escrito" },
        { "value": "tbd", "label": "Por decidir" }
      ]
    },
    {
      "id": "nda_required",
      "type": "single_select",
      "label": "¿Hace falta un NDA (acuerdo de confidencialidad) antes de compartir detalles del proyecto?",
      "required": true,
      "allow_other": true,
      "options": [
        { "value": "no", "label": "No" },
        { "value": "unsure", "label": "Aún no lo sé" },
        { "value": "yes_before", "label": "Sí, antes de compartir detalles" },
        { "value": "yes_institution", "label": "Sí, si mi institución lo exige" }
      ]
    },
    {
      "id": "patent_intention",
      "type": "single_select",
      "label": "¿Tienes intención de patentar resultados de esta colaboración?",
      "required": true,
      "allow_other": true,
      "options": [
        { "value": "no", "label": "No / solo publicación académica" },
        { "value": "unsure", "label": "Aún no lo sé" },
        { "value": "maybe", "label": "Quizá; hay que hablarlo antes de empezar" },
        { "value": "yes", "label": "Sí; quiero acordar reglas pronto" }
      ]
    },
    {
      "id": "possible_ip",
      "type": "single_select",
      "label": "¿Otra PI posible (software, spin-off, producto comercial)?",
      "required": true,
      "allow_other": true,
      "options": [
        { "value": "no", "label": "No / solo académico" },
        { "value": "unsure", "label": "Aún no lo sé" },
        { "value": "maybe", "label": "Quizá; hay que hablarlo antes de empezar" },
        { "value": "yes", "label": "Sí; quiero acordar reglas pronto" }
      ]
    },
    {
      "id": "not_this_collab",
      "type": "multi_select",
      "label": "Esta colaboración NO es (salvo que acordemos lo contrario)",
      "required": true,
      "allow_other": true,
      "options": [
        { "value": "auto_data", "label": "Acceso automático a datos del otro sin acuerdo" },
        { "value": "auto_grant", "label": "Compromiso automático de financiarnos" },
        { "value": "ghostwriting", "label": "Ghostwriting o autoría simbólica" },
        { "value": "paid_consulting", "label": "Consultoría remunerada" },
        { "value": "hierarchy", "label": "Relación director–alumno sin pactarlo" },
        { "value": "synergium_party", "label": "Que Synergium medie disputas indefinidamente" }
      ]
    },
    {
      "id": "wont_do",
      "type": "textarea",
      "label": "Qué no estarías dispuesto/a a hacer en esta colaboración (opcional, 1–3 bullets)",
      "required": false
    },
    {
      "id": "conditions_clarity",
      "type": "single_select",
      "label": "Tus condiciones para este match",
      "required": true,
      "allow_other": true,
      "options": [
        { "value": "clear", "label": "Las tengo claras (este formulario basta)" },
        { "value": "guidance", "label": "Necesito orientación antes de hablar con mi match" },
        { "value": "clarification", "label": "Quiero una aclaración por email o WhatsApp con Synergium para estar segura/o de que lo he entendido todo" }
      ]
    },
    {
      "id": "synergium_checkin",
      "type": "single_select",
      "label": "¿Check-in de Synergium unas 2 semanas después de la introducción?",
      "required": true,
      "allow_other": true,
      "options": [
        { "value": "no", "label": "No; lo gestionamos entre nosotros" },
        { "value": "if_stuck", "label": "Solo si nos atascamos" },
        { "value": "yes", "label": "Sí, un check-in breve me viene bien" }
      ]
    },
    {
      "id": "share_summary_consent",
      "type": "single_select",
      "label": "Acepto que Synergium comparta un resumen breve de mis respuestas con mi match antes de la introducción conjunta",
      "required": true,
      "options": [
        { "value": "no", "label": "No" },
        { "value": "yes", "label": "Sí, acepto" }
      ]
    }
  ]
}
