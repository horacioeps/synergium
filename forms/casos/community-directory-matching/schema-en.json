{
  "version": 1,
  "title": "Researcher directory: matching for collaborations",
  "locale": "en",
  "description": "Goal: connect researchers who can collaborate in concrete ways, for example on a joint paper, a funding call, a method, a research stay, or peer review.\n\nThis form captures your academic profile for that matching. The data are not merely stored: Synergium's professional team curates and processes every profile to establish reliable fits among partners in the database, which already includes around one thousand profiles from a wide range of nationalities.\n\nContact begins anonymously. Then, step by step, understanding is mediated until a fit is confirmed. Only then are the parties connected formally.\n\nIt is free and takes about 8-10 minutes. Please be specific: vague answers are hard to match. Data are not sold or shared with third parties. If an introduction is made, only what you authorise at the end will be shared. To request deletion of your data, use the channel indicated in the footer.\n\nFor further questions, write to info@synergium.net.",
  "success_message": "Thanks — your answers were saved. If you authorised introductions, I may contact you on the channel you chose.",
  "ui": {
    "submit": "Submit",
    "sending": "Sending…",
    "other": "Other",
    "other_placeholder": "Other…",
    "url_placeholder": "One URL per line",
    "thank_you": "Thank you",
    "foot": "Your answers are stored securely. To request deletion, write to info@synergium.net.",
    "complete": "Please complete: ",
    "submit_error": "Could not submit. Please try again.",
    "loading": "Loading…",
    "missing_link": "Open a form link you were given.",
    "missing_form": "This form is closed or the link is invalid.",
    "load_error": "Could not load the form."
  },
