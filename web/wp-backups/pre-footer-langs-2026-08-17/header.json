  "content": {
    "raw": "<!-- wp:group {\"align\":\"full\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group alignfull\">\n\t<!-- wp:group {\"layout\":{\"type\":\"constrained\"}} -->\n\t<div class=\"wp-block-group\">\n\t\t<!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|30\",\"bottom\":\"var:preset|spacing|30\"}}},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n\t\t<div class=\"wp-block-group alignwide\" style=\"padding-top:var(--wp--preset--spacing--30);padding-bottom:var(--wp--preset--spacing--30)\">\n\t\t\t<!-- wp:site-title {\"level\":0} /-->\n\t\t\t<!-- wp:html -->\n<script>\n(function(){\n  try{\n    var t=localStorage.getItem(\"syn-theme\");\n    if(!t){\n      t=\"light\";\n      var mq=window.matchMedia;\n      if(mq){\n        if(mq(\"(prefers-color-scheme: dark)\").matches) t=\"dark\";\n      }\n    }\n    document.documentElement.setAttribute(\"data-theme\",t);\n  }catch(e){}\n})();\n</script>\n<div id=\"google_translate_element\" hidden></div>\n<div class=\"syn-bar\">\n  <nav class=\"syn-nav\" id=\"syn-nav\" aria-label=\"Main\">\n    <a data-key=\"services\" href=\"/services/\">Services</a>\n    <a data-key=\"method\" href=\"/method/\">Method</a>\n    <a data-key=\"about\" href=\"/about/\">About</a>\n    <a data-key=\"contact\" href=\"/contact/\">Contact</a>\n  </nav>\n  <div class=\"syn-toolbar\" translate=\"no\">\n    <div class=\"syn-lang\" id=\"syn-lang\">\n      <button type=\"button\" class=\"syn-lang__btn\" id=\"syn-lang-btn\" aria-haspopup=\"listbox\" aria-expanded=\"false\" aria-controls=\"syn-lang-list\" aria-label=\"Select language\">\n        <svg class=\"syn-lang__globe\" viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\">\n          <circle cx=\"12\" cy=\"12\" r=\"9\"/>\n          <path d=\"M3 12h18\"/>\n          <path d=\"M12 3a14 14 0 0 1 0 18\"/>\n          <path d=\"M12 3a14 14 0 0 0 0 18\"/>\n        </svg>\n        <span class=\"syn-lang__code\" id=\"syn-lang-code\">EN</span>\n      </button>\n      <ul class=\"syn-lang__list\" id=\"syn-lang-list\" role=\"listbox\">\n        <li role=\"option\" data-lang=\"en\"><a href=\"https://synergium.net/\">English</a></li>\n        <li role=\"option\" data-lang=\"es\"><a href=\"https://synergium.net/es/\">Español</a></li>\n        <li role=\"option\" data-lang=\"zh-CN\"><a href=\"https://synergium.net/?lang=zh-CN\">简体中文</a></li>\n        <li role=\"option\" data-lang=\"ar\"><a href=\"https://synergium.net/?lang=ar\">العربية</a></li>\n        <li role=\"option\" data-lang=\"ja\"><a href=\"https://synergium.net/?lang=ja\">日本語</a></li>\n        <li role=\"option\" data-lang=\"pt\"><a href=\"https://synergium.net/?lang=pt\">Português</a></li>\n        <li role=\"option\" data-lang=\"it\"><a href=\"https://synergium.net/?lang=it\">Italiano</a></li>\n        <li role=\"option\" data-lang=\"de\"><a href=\"https://synergium.net/?lang=de\">Deutsch</a></li>\n      </ul>\n    </div>\n    <button type=\"button\" class=\"syn-theme\" id=\"syn-theme-toggle\" aria-pressed=\"false\" aria-label=\"Switch to dark mode\" title=\"Light / Dark\">\n      <svg class=\"syn-theme__sun\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"/></svg>\n      <svg class=\"syn-theme__moon\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M21 14.5A8.5 8.5 0 1 1 9.5 3 7 7 0 0 0 21 14.5z\"/></svg>\n    </button>\n  </div>\n</div>\n<style>\n.syn-kicker{font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;opacity:.72;margin-bottom:0}\n.syn-hero h1{font-size:clamp(1.85rem,4vw,2.85rem);line-height:1.15;max-width:20ch}\n.syn-bar,.syn-toolbar,.syn-lang{overflow:visible}\n.syn-bar{display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap;justify-content:flex-end}\n.syn-nav{display:flex;align-items:center;gap:1.15rem;flex-wrap:wrap}\n.syn-nav a{color:inherit;text-decoration:none;font-size:.95rem}\n.syn-nav a:hover,.syn-nav a[aria-current=\"page\"]{text-decoration:underline}\n.syn-toolbar{display:flex;align-items:center;gap:1rem;flex-wrap:nowrap}\n.syn-lang{position:relative;z-index:40}\n.syn-lang__btn{display:inline-flex;align-items:center;gap:.4rem;padding:.25rem .55rem;border:1px solid color-mix(in srgb,currentColor 35%,transparent);border-radius:999px;background:transparent;color:inherit;cursor:pointer;font:inherit;font-size:.85rem;letter-spacing:.04em}\n.syn-lang__btn:hover,.syn-lang__btn[aria-expanded=\"true\"]{border-color:currentColor}\n.syn-lang__globe{display:block;flex:0 0 auto}\n.syn-lang__code{line-height:1}\n.syn-lang__list{display:none;position:absolute;top:calc(100% + .4rem);right:0;margin:0;padding:.35rem 0;list-style:none;min-width:10.5rem;border:1px solid color-mix(in srgb,currentColor 28%,transparent);border-radius:8px;background:var(--wp--preset--color--base,#fff);color:inherit;box-shadow:0 8px 24px color-mix(in srgb,#000 16%,transparent);z-index:50}\n.syn-lang:focus-within .syn-lang__list,.syn-lang.is-open .syn-lang__list{display:block}\nhtml[data-theme=\"dark\"] .syn-lang__list{background:#1b1b1b}\n.syn-lang__list li{margin:0}\n.syn-lang__list a{display:block;padding:.4rem .85rem;color:inherit;text-decoration:none;font-size:.9rem;cursor:pointer}\n.syn-lang__list a:hover,.syn-lang__list li[aria-selected=\"true\"] a{background:color-mix(in srgb,currentColor 8%,transparent)}\n.syn-theme{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;padding:0;border:1px solid color-mix(in srgb, currentColor 35%, transparent);border-radius:999px;background:transparent;color:inherit;cursor:pointer}\n.syn-theme:hover{border-color:currentColor}\n.syn-theme__moon{display:none}\nhtml[data-theme=\"dark\"] .syn-theme__sun{display:none}\nhtml[data-theme=\"dark\"] .syn-theme__moon{display:block}\nhtml[data-theme=\"dark\"]{\n  --wp--preset--color--base:#131313;\n  --wp--preset--color--contrast:#FFFFFF;\n  --wp--preset--color--accent-1:#4B52FF;\n  --wp--preset--color--accent-2:#FF7A5C;\n  --wp--preset--color--accent-3:#252525;\n  --wp--preset--color--accent-4:#FFFFFF;\n  --wp--preset--color--accent-5:#252525;\n  --wp--preset--color--accent-6:#FFFFFF33;\n  color-scheme:dark;\n  background:#131313;\n}\nhtml[data-theme=\"light\"]{color-scheme:light}\nhtml[dir=\"rtl\"] .syn-lang__list{right:auto;left:0}\n.goog-te-banner-frame,.skiptranslate,iframe.skiptranslate,.goog-te-gadget{display:none!important}\nbody{top:0!important}\n.gt_switcher_wrapper,.gtranslate_wrapper{display:none!important}\n</style>\n<script>\n(function(){\n  var root=document.documentElement;\n  var themeKey=\"syn-theme\";\n  var LANGS={\n    es:{code:\"ES\",dir:\"ltr\",html:\"es\"},\n    en:{code:\"EN\",dir:\"ltr\",html:\"en\"},\n    \"zh-CN\":{code:\"ZH\",dir:\"ltr\",html:\"zh-CN\"},\n    ar:{code:\"AR\",dir:\"rtl\",html:\"ar\"},\n    ja:{code:\"JA\",dir:\"ltr\",html:\"ja\"},\n    pt:{code:\"PT\",dir:\"ltr\",html:\"pt-BR\"},\n    it:{code:\"IT\",dir:\"ltr\",html:\"it\"},\n    de:{code:\"DE\",dir:\"ltr\",html:\"de\"}\n  };\n  var ROUTES=[\n    {en:\"/services\",es:\"/es/servicios\",key:\"services\"},\n    {en:\"/method\",es:\"/es/metodo\",key:\"method\"},\n    {en:\"/about\",es:\"/es/quienes-somos\",key:\"about\"},\n    {en:\"/contact\",es:\"/es/contacto\",key:\"contact\"},\n    {en:\"/\",es:\"/es\",key:\"home\"}\n  ];\n  var NAV={\n    en:{services:\"Services\",method:\"Method\",about:\"About\",contact:\"Contact\"},\n    es:{services:\"Servicios\",method:\"Método\",about:\"Quiénes somos\",contact:\"Contacto\"},\n    ja:{services:\"サービス\",method:\"方法\",about:\"概要\",contact:\"お問い合わせ\"},\n    \"zh-CN\":{services:\"服务\",method:\"方法\",about:\"关于我们\",contact:\"联系\"},\n    ar:{services:\"الخدمات\",method:\"المنهج\",about:\"من نحن\",contact:\"تواصل\"},\n    pt:{services:\"Serviços\",method:\"Método\",about:\"Quem somos\",contact:\"Contacto\"},\n    it:{services:\"Servizi\",method:\"Metodo\",about:\"Chi siamo\",contact:\"Contatto\"},\n    de:{services:\"Leistungen\",method:\"Methode\",about:\"Über uns\",contact:\"Kontakt\"}\n  };\n  function pref(){\n    try{\n      var s=localStorage.getItem(themeKey);\n      if(s===\"dark\") return s;\n      if(s===\"light\") return s;\n    }catch(e){}\n    var mq=window.matchMedia;\n    if(mq){\n      if(mq(\"(prefers-color-scheme: dark)\").matches) return \"dark\";\n    }\n    return \"light\";\n  }\n  function applyTheme(t){\n    root.setAttribute(\"data-theme\", t);\n    var b=document.getElementById(\"syn-theme-toggle\");\n    if(b){\n      var dark=t===\"dark\";\n      b.setAttribute(\"aria-pressed\", dark?\"true\":\"false\");\n      b.setAttribute(\"aria-label\", dark?\"Switch to light mode\":\"Switch to dark mode\");\n    }\n  }\n  applyTheme(pref());\n  function path(){return (location.pathname.replace(/\\/+$/,\"\")||\"/\");}\n  function pair(){\n    var p=path();\n    var i;\n    for(i=0;i<ROUTES.length;i++){\n      if(p===ROUTES[i].en) return ROUTES[i];\n      if(p===ROUTES[i].es) return ROUTES[i];\n    }\n    return ROUTES[ROUTES.length-1];\n  }\n  function abs(p){return \"https://synergium.net\"+(p===\"/\"?\"/\":p+\"/\");}\n  function readCookie(n){\n    var m=document.cookie.match(new RegExp(\"(?:^|; )\"+n+\"=([^;]*)\"));\n    if(m) return decodeURIComponent(m[1]);\n    return \"\";\n  }\n  function writeCookie(n,v){\n    document.cookie=n+\"=\"+v+\";path=/;max-age=31536000\";\n    document.cookie=n+\"=\"+v+\";path=/;domain=\"+location.hostname+\";max-age=31536000\";\n  }\n  function expireCookie(n, domain){\n    var base=n+\"=;path=/;max-age=0;expires=Thu, 01 Jan 1970 00:00:00 GMT\";\n    if(domain) document.cookie=base+\";domain=\"+domain;\n    else document.cookie=base;\n  }\n  function expireGoogtrans(){\n    var host=location.hostname;\n    var names=[\"googtrans\",\"googtranscombo\"];\n    var i,j,domains;\n    domains=[\"\",host,\".\"+host];\n    for(i=0;i<names.length;i++){\n      for(j=0;j<domains.length;j++){\n        if(domains[j]) expireCookie(names[i], domains[j]);\n        else expireCookie(names[i]);\n      }\n    }\n  }\n  function clearTrans(){\n    expireGoogtrans();\n    try{localStorage.removeItem(\"syn-lang\");}catch(e){}\n  }\n  function qlang(){\n    try{\n      var q=new URLSearchParams(location.search).get(\"lang\");\n      if(q){\n        if(LANGS[q]) return q;\n      }\n    }catch(e){}\n    return \"\";\n  }\n  function currentLang(){\n    var p=path();\n    if(p===\"/es\") return \"es\";\n    if(p.indexOf(\"/es/\")===0) return \"es\";\n    if(p===\"/en\") return \"en\";\n    if(p.indexOf(\"/en/\")===0) return \"en\";\n    var ql=qlang();\n    if(ql) return ql;\n    var c=readCookie(\"googtrans\");\n    var m=c.match(/\\/[a-zA-Z-]+\\/([a-zA-Z-]+)/);\n    if(m){\n      if(m[1]===\"en\"){\n        expireGoogtrans();\n        return \"en\";\n      }\n      if(LANGS[m[1]]) return m[1];\n    }\n    try{\n      var s=localStorage.getItem(\"syn-lang\");\n      if(s){\n        if(LANGS[s]){\n          if(s!==\"en\") return s;\n        }\n      }\n    }catch(e){}\n    return \"en\";\n  }\n  function paintNav(uiLang){\n    var labels=NAV[uiLang]||NAV.en;\n    var r=pair();\n    var nav=document.getElementById(\"syn-nav\");\n    if(nav){\n      nav.querySelectorAll(\"a[data-key]\").forEach(function(a){\n        var k=a.getAttribute(\"data-key\");\n        if(labels[k]) a.textContent=labels[k];\n        var dest=null;\n        var i;\n        for(i=0;i<ROUTES.length;i++){if(ROUTES[i].key===k) dest=ROUTES[i];}\n        if(dest){\n          var href=abs(dest.en);\n          if(uiLang===\"es\") href=abs(dest.es);\n          else{\n            if(uiLang!==\"en\") href=href+\"?lang=\"+encodeURIComponent(uiLang);\n          }\n          a.setAttribute(\"href\", href);\n          if(r.key===k) a.setAttribute(\"aria-current\",\"page\");\n          else a.removeAttribute(\"aria-current\");\n        }\n      });\n    }\n    var logo=document.querySelector(\".wp-block-site-title a\");\n    if(logo){\n      if(uiLang===\"es\") logo.setAttribute(\"href\",\"https://synergium.net/es/\");\n      else logo.setAttribute(\"href\",\"https://synergium.net/\");\n    }\n    var fl=document.getElementById(\"syn-footer-langs\");\n    if(fl){\n      if(uiLang===\"es\") fl.textContent=\"El sitio está en inglés y español. Los demás idiomas se eligen en el globo de la cabecera.\";\n      else fl.textContent=\"The site is in English and Spanish. Other languages use the globe in the header.\";\n    }\n  }\n  function paintLang(lang){\n    var meta=LANGS[lang]||LANGS.en;\n    root.setAttribute(\"lang\", meta.html);\n    root.setAttribute(\"dir\", meta.dir);\n    var code=document.getElementById(\"syn-lang-code\");\n    if(code) code.textContent=meta.code;\n    var list=document.getElementById(\"syn-lang-list\");\n    if(list){\n      list.querySelectorAll(\"[data-lang]\").forEach(function(li){\n        li.setAttribute(\"aria-selected\", li.getAttribute(\"data-lang\")===lang?\"true\":\"false\");\n      });\n    }\n    paintNav(lang);\n  }\n  function goLang(lang){\n    var r=pair();\n    if(lang===\"en\"){\n      clearTrans();\n      writeCookie(\"googtrans\",\"/en/en\");\n      location.href=abs(r.en)+\"#googtrans(en|en)\";\n      return;\n    }\n    if(lang===\"es\"){\n      clearTrans();\n      location.href=abs(r.es);\n      return;\n    }\n    writeCookie(\"googtrans\",\"/en/\"+lang);\n    try{localStorage.setItem(\"syn-lang\", lang);}catch(e){}\n    location.href=abs(r.en)+\"?lang=\"+encodeURIComponent(lang);\n  }\n  if(path()===\"/en\"){\n    location.replace(\"https://synergium.net/\");\n    return;\n  }\n  if(path().indexOf(\"/en/\")===0){\n    location.replace(\"https://synergium.net/\");\n    return;\n  }\n  if(location.hash.indexOf(\"googtrans(en\")===0){\n    expireGoogtrans();\n    try{localStorage.removeItem(\"syn-lang\");}catch(e){}\n    if(history.replaceState) history.replaceState(null,\"\",location.pathname);\n  }\n  if(location.hash.indexOf(\"#googtrans(en\")===0){\n    expireGoogtrans();\n    try{localStorage.removeItem(\"syn-lang\");}catch(e){}\n    if(history.replaceState) history.replaceState(null,\"\",location.pathname);\n  }\n  paintLang(currentLang());\n  var wrap=document.getElementById(\"syn-lang\");\n  var btn=document.getElementById(\"syn-lang-btn\");\n  var list=document.getElementById(\"syn-lang-list\");\n  if(btn){\n    if(list){\n      btn.addEventListener(\"click\", function(ev){\n        ev.stopPropagation();\n        var open=wrap.classList.contains(\"is-open\");\n        if(open){\n          wrap.classList.remove(\"is-open\");\n          btn.setAttribute(\"aria-expanded\",\"false\");\n        }else{\n          wrap.classList.add(\"is-open\");\n          btn.setAttribute(\"aria-expanded\",\"true\");\n        }\n      });\n      list.addEventListener(\"click\", function(ev){\n        var a=ev.target.closest(\"a\");\n        if(!a) return;\n        var li=a.closest(\"[data-lang]\");\n        if(!li) return;\n        var lang=li.getAttribute(\"data-lang\");\n        ev.preventDefault();\n        goLang(lang);\n      });\n      document.addEventListener(\"click\", function(){\n        wrap.classList.remove(\"is-open\");\n        btn.setAttribute(\"aria-expanded\",\"false\");\n      });\n    }\n  }\n  document.addEventListener(\"click\", function(ev){\n    var t=ev.target;\n    var b=null;\n    if(t.closest) b=t.closest(\"#syn-theme-toggle\");\n    if(!b) return;\n    var next=root.getAttribute(\"data-theme\")===\"dark\"?\"light\":\"dark\";\n    try{localStorage.setItem(themeKey,next);}catch(e){}\n    applyTheme(next);\n  });\n  var langNow=currentLang();\n  var needGT=true;\n  if(langNow===\"es\") needGT=false;\n  if(langNow===\"en\") needGT=false;\n  if(needGT){\n    window.googleTranslateElementInit=function(){\n      if(!window.google) return;\n      if(!google.translate) return;\n      new google.translate.TranslateElement({\n        pageLanguage:\"en\",\n        includedLanguages:\"zh-CN,ar,ja,pt,it,de\",\n        autoDisplay:false\n      },\"google_translate_element\");\n    };\n    setTimeout(function(){\n      var s=document.createElement(\"script\");\n      s.src=\"https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit\";\n      document.head.appendChild(s);\n    },300);\n  }\n})();\n</script>\n\t\t\t<!-- /wp:html -->\n\t\t</div>\n\t\t<!-- /wp:group -->\n\t</div>\n\t<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n",
    "block_version": 1
  },
